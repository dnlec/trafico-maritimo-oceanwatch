{
  "datasets": [
    {
      "name": "indicadores",
      "displayName": "Indicadores",
      "queryLines": [
        "SELECT (SELECT coalesce(sum(n_posiciones),0) FROM dbr_acad_ingsistemas_mine.default.oceanwatch_gold_trafico_celda_hora WHERE fecha = :dia) AS posiciones,\n",
        " (SELECT count(*) FROM dbr_acad_ingsistemas_mine.default.oceanwatch_gold_trayectorias WHERE fecha = :dia) AS buques,\n",
        " (SELECT count_if(estado='evaluado') FROM dbr_acad_ingsistemas_mine.default.oceanwatch_gold_anomalias WHERE fecha = :dia) AS evaluados,\n",
        " (SELECT count_if(es_anomalia) FROM dbr_acad_ingsistemas_mine.default.oceanwatch_gold_anomalias WHERE fecha = :dia) AS alertas"
      ],
      "parameters": [
        {
          "keyword": "dia",
          "displayName": "Día AIS (UTC)",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "mapa",
      "displayName": "Mapa",
      "queryLines": [
        "WITH celdas AS (\n",
        " SELECT h3_cell, sum(n_posiciones) AS mensajes FROM dbr_acad_ingsistemas_mine.default.oceanwatch_gold_trafico_celda_hora\n",
        " WHERE fecha = :dia GROUP BY h3_cell ORDER BY mensajes DESC, h3_cell LIMIT 3000\n",
        "), centros AS (SELECT *, from_json(h3_centerasgeojson(h3_cell),'STRUCT<coordinates:ARRAY<DOUBLE>>').coordinates AS xy FROM celdas)\n",
        "SELECT h3_cell, xy[1] AS latitud, xy[0] AS longitud, mensajes FROM centros"
      ],
      "parameters": [
        {
          "keyword": "dia",
          "displayName": "Día AIS (UTC)",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ranking",
      "displayName": "Ranking",
      "queryLines": [
        "WITH p AS (SELECT numero_puerto, puerto, pais, count(DISTINCT MMSI) AS buques\n",
        " FROM dbr_acad_ingsistemas_mine.default.oceanwatch_gold_presencia_puertos WHERE fecha = :dia GROUP BY numero_puerto, puerto, pais)\n",
        "SELECT concat(lpad(cast(row_number() over(order by buques DESC, puerto, pais, numero_puerto) as string), 2, '0'),' · ',puerto,' · ',pais,' · ',numero_puerto) AS nombre, buques\n",
        "FROM p ORDER BY buques DESC, puerto, pais, numero_puerto LIMIT 12"
      ],
      "parameters": [
        {
          "keyword": "dia",
          "displayName": "Día AIS (UTC)",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "presencia",
      "displayName": "Presencia",
      "queryLines": [
        "SELECT puerto, pais, numero_puerto, MMSI, inicio, fin, n_posiciones FROM dbr_acad_ingsistemas_mine.default.oceanwatch_gold_presencia_puertos\n",
        "WHERE fecha = :dia ORDER BY n_posiciones DESC, puerto, numero_puerto, MMSI"
      ],
      "parameters": [
        {
          "keyword": "dia",
          "displayName": "Día AIS (UTC)",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "anomalias",
      "displayName": "Anomalias",
      "queryLines": [
        "SELECT MMSI, round(sog_media,2) AS sog_nudos, round(velocidad_tramos,2) AS tramos_nudos,\n",
        " round(brecha,2) AS brecha_nudos, round(score,5) AS score, modelo_version\n",
        "FROM dbr_acad_ingsistemas_mine.default.oceanwatch_gold_anomalias WHERE fecha = :dia AND es_anomalia IS TRUE ORDER BY score DESC, MMSI"
      ],
      "parameters": [
        {
          "keyword": "dia",
          "displayName": "Día AIS (UTC)",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    }
  ],
